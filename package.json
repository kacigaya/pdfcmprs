{
  "name": "pdfcmprs",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "bun run copy-assets && next dev",
    "build": "bun run copy-assets && next build",
    "copy-assets": "bun run scripts/copy-assets.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
