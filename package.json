{
  "name": "pdfcmprs",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "bun run copy-pdf-worker && next dev",
    "build": "bun run copy-pdf-worker && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run build",
    "copy-pdf-worker": "mkdir -p public && cp node_modules/pdfjs-dist/build/pdf.worker.min.mjs public/pdf.worker.min.mjs"
  },
  "dependencies": {
    "next": "16.2.4",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^5.6.205",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "bun@1.3.11"
}
