    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "coherentpdf": "2.5.5",
    "cropperjs": "2.1.1",
    "diff": "9.0.0",
    "heic-decode": "2.1.0",
    "lucide-react": "^1.23.0",
    "microdiff": "1.5.0",
    "mupdf": "1.28.0",
    "next": "16.2.4",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^5.6.205",
